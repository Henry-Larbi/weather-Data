# Copy to `.env` and fill in your Supabase project values.
# Without these, PyLearn runs fine in local mode (content from bundled JSON,
# progress saved to localStorage).

# --- Client (safe to expose; shipped in the browser bundle) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only, used ONLY by `npm run sync:content` (never shipped) ---
# Find this under Project Settings -> API -> service_role key. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
